# Environment Variables for AiAutoPricingScanner

# ─── Required for live scanning ───────────────────────────────────────────────
# Google Vision API key (free tier: 1000 requests/month)
# Get it at: https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_VISION_API_KEY=

# eBay Developer App ID (free account at https://developer.ebay.com)
# Used to search SOLD/completed listings for real buyer prices
EBAY_APP_ID=

# ─── Optional pricing sources ─────────────────────────────────────────────────
# PriceCharting API key (optional — some data available without key)
# https://www.pricecharting.com/api
PRICECHARTING_API_KEY=

# Discogs personal access token (free at https://www.discogs.com/settings/developers)
# Used for vinyl records and music memorabilia pricing
DISCOGS_TOKEN=

# ─── Server config ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Client URL (for CORS) ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
